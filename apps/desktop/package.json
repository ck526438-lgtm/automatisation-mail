{
  "name": "@am/desktop",
  "productName": "Automatisation Mail",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "Application de bureau d'Automatisation Mail (Windows, macOS, Linux) : tout fonctionne sur le poste, sans serveur.",
  "scripts": {
    "stage": "node scripts/build.mjs",
    "smoke": "node scripts/smoke.mjs",
    "dist": "node scripts/build.mjs && electron-builder --config electron-builder.json --publish never",
    "dist:win": "node scripts/build.mjs && electron-builder --config electron-builder.json --win --publish never",
    "dist:mac": "node scripts/build.mjs && electron-builder --config electron-builder.json --mac --publish never",
    "dist:linux": "node scripts/build.mjs && electron-builder --config electron-builder.json --linux --publish never",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@am/api": "workspace:*",
    "@am/core": "workspace:*",
    "@am/db": "workspace:*",
    "@am/worker": "workspace:*",
    "electron": "33.4.11",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.2",
    "mailparser": "^3",
    "smtp-server": "^3"
  }
}
